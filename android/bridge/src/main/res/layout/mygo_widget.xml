<?xml version="1.0" encoding="utf-8"?>
<!--
  通用小组件布局：标题 + 最多 4 行（label / subtitle）。行数与文案由 Go 侧的
  Widget.Set 决定，未使用的行在 Kotlin 侧设为 GONE。

  颜色是浅色值。要让小组件跟应用主题一致，改这里的颜色与 mygo_widget_bg。
  RemoteViews 只能用系统控件，自绘的 Go UI 放不进来 —— 这是小组件的硬限制。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/mygo_widget_bg"
    android:padding="12dp">

    <TextView
        android:id="@+id/mygo_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="MyGo"
        android:textColor="#1D1D1F"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/mygo_widget_row0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mygo_widget_row0_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1D1D1F"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/mygo_widget_row0_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#60636A"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mygo_widget_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mygo_widget_row1_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1D1D1F"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/mygo_widget_row1_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#60636A"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mygo_widget_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mygo_widget_row2_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1D1D1F"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/mygo_widget_row2_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#60636A"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mygo_widget_row3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mygo_widget_row3_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1D1D1F"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/mygo_widget_row3_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#60636A"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
