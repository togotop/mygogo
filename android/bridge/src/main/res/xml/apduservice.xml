<?xml version="1.0" encoding="utf-8"?>
<!--
  卡模拟（HCE）的 AID 声明。

  F04D59474F3031 是 mygo 自己的应用标识（F0 + "MYGO01"）：没有应用在跑卡模拟时，
  系统把 APDU 路由到这里，服务直接回 6F00。真正要应答哪些 AID 由 Go 侧
  NFC.Emulate 传进来的列表在运行时注册（CATEGORY_OTHER）。
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/mygo_hce_description"
    android:requireDeviceUnlock="false">
    <aid-group
        android:category="other"
        android:description="@string/mygo_hce_aids">
        <aid-filter android:name="F04D59474F3031" />
    </aid-group>
</host-apdu-service>
